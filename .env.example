POSTGRES_USER=fhir
POSTGRES_PASSWORD=
POSTGRES_DB=fhir_db
# Rol fhir_lector: solo SELECT, lo usa la api para /api/preguntar y los GET.
POSTGRES_PASSWORD_LECTURA=
LLM_MODELO=qwen2.5-coder-fhir:3b
LLM_API_KEY=local
# Respaldo opcional: el reintento de auto-corrección escala a él. Vacío = sigue con el local.
# Ejemplo Groq: LLM_URL_RESPALDO=https://api.groq.com/openai/v1  LLM_MODELO_RESPALDO=llama-3.3-70b-versatile
LLM_URL_RESPALDO=
LLM_MODELO_RESPALDO=
LLM_API_KEY_RESPALDO=local
# 1 solo si aceptas que las preguntas y el catálogo (nunca las filas) salgan de esta máquina.
PERMITIR_LLM_EXTERNO=0
